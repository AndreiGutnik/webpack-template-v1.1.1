{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/",
    "noEmit": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "target": "esnext",
    "jsx": "react-jsx",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "public", "config"],
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  }
}
